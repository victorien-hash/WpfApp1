<Window x:Class="WpfApp1.GererCompteMembre"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TP2Ciné – Gestion membre" Height="600" Width="900"
        Background="#1E1E1E" WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#E50914">
            <Grid Margin="20,0">
                <TextBlock Text="🎬 Espace Membre" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="txtBienvenue" Text="Bienvenue" Foreground="White" Margin="0,0,15,0" VerticalAlignment="Center"/>
                    <Button Content="Retour Accueil" Click="BtnRetour_Click" Background="#3A3A3A" Foreground="White" Padding="10,5" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="20" Background="#2E2E2E" Foreground="White">

            <TabItem Header="Modifier profil">
                <ScrollViewer>
                    <StackPanel Width="400" Margin="0,20">
                        <TextBlock Text="👤 Modifier mes informations" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                        <Label Content="Nom" Foreground="White"/>
                        <TextBox x:Name="txtEditNom" Padding="5" Margin="0,0,0,10"/>

                        <Label Content="Prénom" Foreground="White"/>
                        <TextBox x:Name="txtEditPrenom" Padding="5" Margin="0,0,0,10"/>

                        <Label Content="Courriel" Foreground="White"/>
                        <TextBox x:Name="txtEditEmail" Padding="5" Margin="0,0,0,10"/>

                        <Label Content="Nouveau mot de passe (Laisser vide si inchangé)" Foreground="White"/>
                        <PasswordBox x:Name="txtEditPassword" Padding="5" Margin="0,0,0,20"/>

                        <Button Content="💾 Enregistrer les modifications" Click="BtnModifierProfil_Click" Background="#E50914" Foreground="White" Padding="10" FontWeight="Bold"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="S'abonner">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="400">
                    <TextBlock Text="💎 Choisissez votre abonnement" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <TextBlock Text="Abonnement actuel :" Foreground="Gray" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="txtAboActuel" Text="Aucun" Foreground="#00FF7F" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                    <ComboBox x:Name="cbAbonnement" Margin="0,0,0,20" Padding="10">
                        <ComboBoxItem Content="Mensuel - 9.99$" Tag="9.99"/>
                        <ComboBoxItem Content="Annuel - 99.99$" Tag="99.99"/>
                        <ComboBoxItem Content="Premium - 14.99$" Tag="14.99"/>
                    </ComboBox>

                    <Button Content="S'abonner maintenant" Click="BtnAbonner_Click" Background="#E50914" Foreground="White" Padding="10" FontWeight="Bold"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Obtenir remboursement">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="400">
                    <TextBlock Text="💸 Demande de remboursement" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                    <Label Content="Montant à rembourser ($)" Foreground="White"/>
                    <TextBox x:Name="txtMontantRemboursement" Padding="5" Margin="0,0,0,10"/>

                    <Label Content="Motif de la demande" Foreground="White"/>
                    <TextBox x:Name="txtMotifRemboursement" Height="80" TextWrapping="Wrap" Padding="5" Margin="0,0,0,20"/>

                    <Button Content="Soumettre la demande" Click="BtnRemboursement_Click" Background="#E50914" Foreground="White" Padding="10" FontWeight="Bold"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Consulter solde">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="💰 Votre solde actuel" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                    <Border Background="#1E1E1E" CornerRadius="15" Padding="40" BorderBrush="#E50914" BorderThickness="2">
                        <TextBlock x:Name="txtSoldeDisplay" Text="0.00 $" Foreground="#00FF7F" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </Border>

                    <Button Content="🔄 Actualiser" Click="BtnRefresh_Click" Background="#3A3A3A" Foreground="White" Margin="0,20,0,0" Padding="10,5"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Consulter transactions">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="93*"/>
                        <ColumnDefinition Width="46*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="📜 Historique des transactions" FontSize="22" FontWeight="Bold" Margin="0,0,0,15" Grid.ColumnSpan="2"/>

                    <ListView x:Name="lstTransactions" Background="#1E1E1E" Foreground="White" BorderThickness="0" Grid.ColumnSpan="2" Margin="0,44,0,0" Grid.RowSpan="2">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Date" DisplayMemberBinding="{Binding DateTransaction, StringFormat=g}" Width="150"/>
                                <GridViewColumn Header="Type" DisplayMemberBinding="{Binding Type}" Width="200"/>
                                <GridViewColumn Header="Montant" DisplayMemberBinding="{Binding Montant, StringFormat={}{0:C}}" Width="100"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>

            <TabItem Header="Approvisionner compte">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="400">
                    <TextBlock Text="➕ Ajouter des fonds" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                    <Label Content="Montant à ajouter ($)" Foreground="White"/>
                    <TextBox x:Name="txtMontantApprovisionnement" Padding="5" Margin="0,0,0,10"/>

                    <Label Content="Mode de paiement" Foreground="White"/>
                    <ComboBox Margin="0,0,0,20" Padding="5" SelectedIndex="0">
                        <ComboBoxItem Content="Carte de crédit (Simulé)"/>
                        <ComboBoxItem Content="PayPal (Simulé)"/>
                    </ComboBox>

                    <Button Content="Confirmer le paiement" Click="BtnApprovisionner_Click" Background="#E50914" Foreground="White" Padding="10" FontWeight="Bold"/>
                </StackPanel>
            </TabItem>

        </TabControl>
    </Grid>
</Window>