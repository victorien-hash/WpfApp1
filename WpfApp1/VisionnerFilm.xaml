<Window x:Class="WpfApp1.VisionnerFilm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TP2Ciné – Visionner" Height="600" Width="900"
        Background="#1E1E1E" Icon="/icones/visionnerfilm.ico"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <ScrollViewer>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="600" Margin="0,20">

                <TextBlock x:Name="txtTitreFilm" Text="Titre du Film" Foreground="White" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <Border Background="Black" Height="350" CornerRadius="5" Margin="0,0,0,15">
                    <Grid>
                        <TextBlock Text="▶ Lecture Vidéo (Simulation)" Foreground="Gray" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20"/>
                    </Grid>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,25">
                    <Button Content="▶ Play" Background="#E50914" Foreground="White" Width="80" Margin="5" Padding="5"/>
                    <Button Content="⏸ Pause" Background="#444" Foreground="White" Width="80" Margin="5" Padding="5"/>
                    <Button Content="⏹ Stop" Background="#444" Foreground="White" Width="80" Margin="5" Padding="5"/>
                </StackPanel>

                <StackPanel Margin="10">
                    <TextBlock x:Name="txtGenre" Text="Genre : Action" Foreground="#AAAAAA" FontSize="16" Margin="0,0,0,5"/>
                    <TextBlock x:Name="txtAnnee" Text="Année : 2024" Foreground="#AAAAAA" FontSize="16" Margin="0,0,0,15"/>

                    <TextBlock Text="Synopsis :" Foreground="White" FontWeight="Bold" FontSize="18" Margin="0,0,0,5"/>
                    <TextBlock x:Name="txtDescription" Text="Description du film..." Foreground="White" TextWrapping="Wrap" FontSize="14" LineHeight="20"/>
                </StackPanel>

                <Button Content="← Retour à l'accueil" Click="BtnRetour_Click" Background="#3A3A3A" Foreground="White" Width="150" Margin="0,30,0,0" Padding="10"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>