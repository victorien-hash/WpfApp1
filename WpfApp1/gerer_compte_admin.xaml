<Window x:Class="WpfApp1.gerer_compte_admin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TP2Ciné – Administration" Height="550" Width="700"
        WindowStartupLocation="CenterScreen" Background="#1E1E1E" Icon="/icones/gerercomptes.ico">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#E50914" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="🎬 Administration" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="🏠 Retour Accueil" Click="BtnRetourAccueil_Click" Background="#3A3A3A" Foreground="White" Padding="10,5" Margin="5"/>
                    <Button Content="⚙️ Gestion Films" Background="White" Foreground="Red" Padding="10,5" Margin="5" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="Mode Admin" Foreground="White" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <Button Content="Déconnexion" Click="BtnDeconnexion_Click" Background="#3A3A3A" Foreground="White" FontWeight="Bold" Padding="10,5" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="20" Background="#2E2E2E" Foreground="White">

            <TabItem Header="Ajouter un film">
                <ScrollViewer>
                    <StackPanel Width="420" Margin="0,20">
                        <TextBlock Text="🎬 Ajouter un film" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                        <Label Content="Titre" Foreground="White"/>
                        <TextBox x:Name="AjouterTitreTextBox" Margin="0,0,0,10" Padding="5"/>

                        <Label Content="Genre" Foreground="White"/>
                        <ComboBox x:Name="AjouterGenreComboBox" Margin="0,0,0,10" Padding="5">
                            <ComboBoxItem Content="Action"/>
                            <ComboBoxItem Content="Comédie"/>
                            <ComboBoxItem Content="Drame"/>
                            <ComboBoxItem Content="Science-fiction"/>
                        </ComboBox>

                        <Label Content="Année" Foreground="White"/>
                        <TextBox x:Name="AjouterAnneeTextBox" Margin="0,0,0,10" Padding="5"/>

                        <Label Content="Description" Foreground="White"/>
                        <TextBox x:Name="AjouterDescriptionTextBox" Height="80" TextWrapping="Wrap" Margin="0,0,0,20" Padding="5"/>

                        <Button Content="💾 Ajouter le film" Click="BtnAjouterFilm_Click" Background="#E50914" Foreground="White" Padding="10,5" Width="150"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Modifier un film">
                <ScrollViewer>
                    <StackPanel Width="420" Margin="0,20">
                        <TextBlock Text="✏️ Modifier un film" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                        <Label Content="Titre du film à modifier (Recherche exacte)" Foreground="White"/>
                        <TextBox x:Name="ModifTitreRechercheBox" Margin="0,0,0,10" Padding="5"/>
                        <Button Content="🔍 Charger infos" Click="BtnChargerFilm_Click" Background="#444" Foreground="White" Margin="0,0,0,20"/>

                        <Label Content="Nouveau Titre" Foreground="White"/>
                        <TextBox x:Name="ModifTitreTextBox" Margin="0,0,0,10" Padding="5"/>

                        <Label Content="Nouveau Genre" Foreground="White"/>
                        <ComboBox x:Name="ModifGenreComboBox" Margin="0,0,0,10" Padding="5">
                            <ComboBoxItem Content="Action"/>
                            <ComboBoxItem Content="Comédie"/>
                            <ComboBoxItem Content="Drame"/>
                            <ComboBoxItem Content="Science-fiction"/>
                        </ComboBox>

                        <Label Content="Nouvelle Description" Foreground="White"/>
                        <TextBox x:Name="ModifDescriptionTextBox" Height="80" TextWrapping="Wrap" Margin="0,0,0,20" Padding="5"/>

                        <Button Content="💾 Enregistrer les modifications" Click="BtnEnregistrerModif_Click" Background="#E50914" Foreground="White" Padding="10,5" Width="200"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Enlever un film">
                <StackPanel Width="420" Margin="0,50">
                    <TextBlock Text="❌ Supprimer un film" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <Label Content="Titre du film à supprimer" Foreground="White"/>
                    <TextBox x:Name="SupprTitreTextBox" Margin="0,0,0,20" Padding="5"/>
                    <Button Content="🗑️ Supprimer définitivement" Click="BtnSupprimerFilm_Click" Background="#E50914" Foreground="White" Padding="10,5" Width="200"/>
                </StackPanel>
            </TabItem>

        </TabControl>
    </Grid>
</Window>