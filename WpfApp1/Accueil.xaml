<Window x:Class="WpfApp1.Accueil"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TP2Ciné – Accueil" 
        Height="600" Width="900"
        Background="#1E1E1E" Icon="/icones/acceuil.ico"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#252525" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="🎬 TP2Ciné" Foreground="#E50914" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Button Content="🏠 Accueil" Background="Transparent" Foreground="White" BorderThickness="0" Margin="10,0" FontWeight="Bold"/>
                    <Button Content="⚙️ Admin" Click="BtnNavAdmin_Click" Background="Transparent" Foreground="Gray" BorderThickness="0" Margin="10,0" Cursor="Hand"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="👤 Mon Profil" Click="BtnProfil_Click" Background="#3A3A3A" Foreground="White" Padding="10,5" Margin="0,0,10,0" Cursor="Hand"/>
                    <Button Content="Déconnexion" Click="BtnDeconnexion_Click" Background="#E50914" Foreground="White" FontWeight="Bold" Padding="10,5" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="20,10,20,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                <TextBox x:Name="txtRecherche" Width="400" Height="35" FontSize="14" Padding="10,0" VerticalContentAlignment="Center"
                         Text="Rechercher un film..." Foreground="Gray" 
                         GotFocus="TxtRecherche_GotFocus" LostFocus="TxtRecherche_LostFocus"/>
                <Button Content="🔍 Rechercher" Click="BtnRechercher_Click" Background="#E50914" Foreground="White" FontWeight="Bold" Padding="15,0" Cursor="Hand"/>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="txtTitreSection" Text="🎬 Tous les films" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>
                    <WrapPanel x:Name="ListeFilms" Orientation="Horizontal" HorizontalAlignment="Center"/>
                </StackPanel>
            </ScrollViewer>
        </StackPanel>
    </Grid>
</Window>