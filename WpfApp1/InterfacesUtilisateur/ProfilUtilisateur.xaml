<Window x:Class="WpfApp1.ProfilUtilisateur"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TP2Ciné – Mon Profil" Height="450" Width="600"
        Background="#1E1E1E" WindowStartupLocation="CenterScreen">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="👤 Mon Profil" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>
            <TextBlock Text="Fonctionnalité à venir..." Foreground="Gray" FontSize="16" HorizontalAlignment="Center"/>
            <Button Content="Fermer" IsCancel="True" Margin="0,20,0,0" Padding="10,5" Background="#E50914" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>