<Window x:Class="WpfApp1.Inscription"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TP2Ciné – Inscription" 
        Height="550" Width="800"
        Background="#1E1E1E" Icon="/icones/inscription.ico"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300" Margin="0,20">

                <TextBlock Text="🎬 TP2Ciné" Foreground="White" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="Inscription" Foreground="White" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                <Label Content="Nom" Foreground="White" Margin="0,5"/>
                <TextBox x:Name="txtNom" Height="35" Padding="10" Margin="0,0,0,10"/>

                <Label Content="Prénom" Foreground="White" Margin="0,5"/>
                <TextBox x:Name="txtPrenom" Height="35" Padding="10" Margin="0,0,0,10"/>

                <Label Content="Nom d'utilisateur" Foreground="White" Margin="0,5"/>
                <TextBox x:Name="txtUsername" Height="35" Padding="10" Margin="0,0,0,10"/>

                <Label Content="Courriel" Foreground="White" Margin="0,5"/>
                <TextBox x:Name="txtEmail" Height="35" Padding="10" Margin="0,0,0,10"/>

                <Label Content="Mot de passe" Foreground="White" Margin="0,5"/>
                <PasswordBox x:Name="txtPassword" Height="35" Padding="10" Margin="0,0,0,10"/>

                <Label Content="Confirmer le mot de passe" Foreground="White" Margin="0,5"/>
                <PasswordBox x:Name="txtConfirmPass" Height="35" Padding="10" Margin="0,0,0,20"/>

                <CheckBox x:Name="chkEstAdmin" 
                          Content="Créer un compte Administrateur" 
                          Foreground="White" 
                          FontSize="14"
                          Margin="0,0,0,20"/>
                
                <Button x:Name="BtnSInscrire" Content="S'inscrire" Click="BtnSInscrire_Click"
                        Background="#E50914" Foreground="White" FontWeight="Bold" Height="40" Margin="0,10,0,15" Cursor="Hand"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
                    <TextBlock Text="Déjà un compte ? " Foreground="White"/>
                    <TextBlock Text="Se connecter" MouseLeftButtonDown="BtnRetourConnexion_Click"
                               Foreground="#E50914" TextDecorations="Underline" Cursor="Hand"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>